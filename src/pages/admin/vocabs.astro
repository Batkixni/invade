---
import Layout from "@/layouts/Layout.astro";
import { auth } from "@/lib/auth";
import { getAllVocabs } from "@/lib/db/queries";
import { db, schema } from "@/lib/db";
import { eq } from "drizzle-orm";

const session = await auth.api.getSession({ headers: Astro.request.headers });
if (!session) {
  return Astro.redirect("/admin/login");
}

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const action = formData.get("_action");

  if (action === "delete") {
    const word = formData.get("word") as string;
    await db.delete(schema.vocabs).where(eq(schema.vocabs.word, word));
    return Astro.redirect("/admin/vocabs");
  }
}

const allVocabs = await getAllVocabs();
---

<Layout title="詞彙管理 - 管理後台 - 笨他侵略">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between mb-8">
      <h1 class="text-3xl font-black tracking-tight">詞彙管理</h1>
      <a href="/admin/vocabs/new" class="rounded-md bg-foreground text-background px-4 py-2 text-sm font-medium hover:bg-foreground/90 transition-colors">
        新增詞彙
      </a>
    </div>

    <div class="overflow-x-auto rounded-lg border border-border">
      <table class="w-full text-sm">
        <thead class="bg-muted">
          <tr>
            <th class="px-4 py-3 text-left font-medium text-muted-foreground">詞彙</th>
            <th class="px-4 py-3 text-left font-medium text-muted-foreground">注音</th>
            <th class="px-4 py-3 text-left font-medium text-muted-foreground">分類</th>
            <th class="px-4 py-3 text-left font-medium text-muted-foreground">分數</th>
            <th class="px-4 py-3 text-right font-medium text-muted-foreground">操作</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          {allVocabs.map((vocab) => (
            <tr class="hover:bg-muted/50 transition-colors">
              <td class="px-4 py-3 font-medium">{vocab.word}</td>
              <td class="px-4 py-3 text-muted-foreground">{vocab.bopomofo}</td>
              <td class="px-4 py-3 text-muted-foreground">{vocab.category}</td>
              <td class="px-4 py-3">{vocab.score}</td>
              <td class="px-4 py-3 text-right space-x-2">
                <a href={`/admin/vocabs/${vocab.word}`} class="text-invade-600 hover:text-invade-700 transition-colors">
                  編輯
                </a>
                <form method="POST" class="inline">
                  <input type="hidden" name="_action" value="delete" />
                  <input type="hidden" name="word" value={vocab.word} />
                  <button type="submit" class="text-destructive hover:text-destructive/80 transition-colors" onclick="return confirm('確定刪除?')">
                    刪除
                  </button>
                </form>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</Layout>
