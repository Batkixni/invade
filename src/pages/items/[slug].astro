---
import Layout from "@/layouts/Layout.astro";
import ScoreBadge from "@/components/ui/ScoreBadge";
import { getAllItems } from "@/lib/db/queries";
import type { ItemWithRelations } from "@/lib/db/queries";
import { translateCategory, translateOwner, translateType } from "@/lib/utils";

export const prerender = true;

export async function getStaticPaths() {
  const items = await getAllItems();
  return items.map((item) => ({
    params: { slug: item.code },
    props: { item },
  }));
}

const { item } = Astro.props as { item: ItemWithRelations };

const code = item.code;
const allItems = await getAllItems();
const codeToNameMap = new Map(allItems.map((i) => [i.code, i.name]));

const relatedItems = allItems.filter(
  (i) => i.code !== code && (i.category === item.category || i.parentCode === item.parentCode),
).slice(0, 6);

function renderMarkdown(text: string): string {
  if (!text) return "";
  const replacedLinks = text.replace(/\[\[([a-zA-Z0-9_-]+)(?:\|(.+?))?\]\]/g, (_match, targetCode, label) => {
    const textToShow = label || codeToNameMap.get(targetCode) || targetCode;
    return `<a href="/items/${encodeURIComponent(targetCode)}" class="text-sky-400 hover:text-sky-300 underline font-mono">${textToShow}</a>`;
  });

  const escaped = replacedLinks
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;");

  const restored = escaped
    .replace(/&lt;a href="/g, '<a href="')
    .replace(/" class="text-sky-400 hover:text-sky-300 underline font-mono"&gt;/g, '" class="text-sky-400 hover:text-sky-300 underline font-mono">')
    .replace(/&lt;\/a&gt;/g, '</a>');

  const withInline = restored
    .replace(/\*\*(.+?)\*\*/g, "<strong class='text-zinc-100 font-semibold'>$1</strong>")
    .replace(/\*(.+?)\*/g, "<em class='text-zinc-300'>$1</em>")
    .replace(/\[(.+?)\]\((.+?)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer" class="underline text-sky-400 hover:text-white transition-colors">$1</a>');

  const paragraphs = withInline
    .split(/\n\s*\n/)
    .map((p) => `<p class="mb-3 leading-relaxed">${p.replace(/\n/g, "<br>")}</p>`)
    .join("");
  return paragraphs;
}

function getBarSegments(val: number, maxVal: number, totalSegments = 10) {
  if (maxVal <= 0) return { filledCount: 0, isMax: false };
  const ratio = Math.min(1, Math.max(0, val / maxVal));
  const filledCount = Math.round(ratio * totalSegments);
  const isMax = val >= maxVal;
  return { filledCount, isMax };
}

const ownerVal = (item.scoreOwner || 0) / 10;
const typeVal = (item.scoreType || 0) / 10;
const eventsVal = (item.scoreEvents || 0) / 10;
const inheritanceVal = (item.scoreInheritance || 0) / 10;

const barOwner = getBarSegments(ownerVal, 4.0, 10);
const barType = getBarSegments(typeVal, 3.0, 10);
const barEvents = getBarSegments(eventsVal, 3.0, 10);
const barInheritance = getBarSegments(inheritanceVal, 10.0, 10);

const parentName = item.parentCode ? (codeToNameMap.get(item.parentCode) || item.parentCode) : null;
---

<Layout
  title={`《${item.name}》介紹說明 — invade <taiwan>`}
  description={item.description?.slice(0, 200) || `${item.name}的侵略資訊`}
  image={`/logos/${item.code}.jpg`}
>
  <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8 font-mono">
    <div class="flex flex-col gap-8">
      <!-- Back Link -->
      <div>
        <a href="/" class="inline-flex items-center gap-1.5 text-xs sm:text-sm text-zinc-400 hover:text-white transition-colors border border-zinc-800 bg-[#16161a] px-3.5 py-1.5 font-mono">
          ← 返回資料庫目錄
        </a>
      </div>

      <!-- Header -->
      <div class="flex flex-col gap-6 sm:flex-row sm:items-start border-b border-zinc-800 pb-8">
        <img
          src={`/logos/${item.code}.jpg`}
          alt={item.name}
          class="h-24 w-24 shrink-0 border border-zinc-800 bg-[#0e0e11] object-cover"
          onerror="this.style.display='none'"
        />
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center gap-3">
            <h1 class="text-2xl font-bold tracking-tight text-zinc-100 sm:text-3xl font-mono">{item.name}</h1>
          </div>
          {item.nameAlias && (
            <p class="mt-1.5 text-xs sm:text-sm text-zinc-400 font-mono">別名：{item.nameAlias}</p>
          )}
          <div class="mt-4 flex flex-wrap items-center gap-2 text-xs sm:text-sm font-mono">
            <ScoreBadge score={item.score} size="lg" showLevel={true} />
            <span class="border border-zinc-800 bg-[#16161a] px-3 py-1 text-xs sm:text-sm text-zinc-300">
              [{translateOwner(item.owner)}]
            </span>
            <span class="border border-zinc-800 bg-[#16161a] px-3 py-1 text-xs sm:text-sm text-zinc-300">
              [{translateType(item.type)}]
            </span>
            <span class="border border-zinc-800 bg-[#16161a] px-3 py-1 text-xs sm:text-sm text-zinc-300">
              [{translateCategory(item.category)}]
            </span>
          </div>
        </div>
      </div>

      <!-- 4-Dimension Risk Score Breakdown Panel -->
      <section class="border border-zinc-800 bg-[#16161a] p-6 font-mono">
        <h2 class="mb-5 text-sm sm:text-base font-bold text-zinc-200 uppercase tracking-wider font-mono flex flex-wrap items-center gap-2">
          <span>+ 侵略滲透威脅評分維度拆解</span>
          <span class="text-xs text-zinc-500 font-normal">(最終總分最高上限封頂為 10 分)</span>
        </h2>


        <div class="space-y-4 text-xs sm:text-sm font-mono">
          <!-- Dimension 1: Owner -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-zinc-800/80 pb-3 gap-3">
            <div class="flex flex-wrap items-center gap-2.5 min-w-0">
              <span class="text-zinc-500 font-bold shrink-0">[1]</span>
              <span class="text-zinc-100 font-bold shrink-0">資本權屬風險</span>
              <span class="text-zinc-300 text-xs border border-zinc-800 bg-[#0e0e11] px-2 py-0.5 font-mono">
                [{translateOwner(item.owner)}]
              </span>
            </div>
            <div class="flex items-center gap-3 shrink-0 ml-auto font-mono whitespace-nowrap">
              <div class="flex items-center gap-1 font-mono shrink-0">
                <span class="text-zinc-500 font-bold">[</span>
                <div class="flex items-center gap-[3px] w-28">
                  {Array.from({ length: 10 }).map((_, i) => (
                    <div
                      class={`h-2.5 flex-1 ${
                        i < barOwner.filledCount
                          ? barOwner.isMax
                            ? "bg-rose-500"
                            : "bg-zinc-100"
                          : "bg-[#27272e]"
                      }`}
                    />
                  ))}
                </div>
                <span class="text-zinc-500 font-bold">]</span>
              </div>
              <span class="text-zinc-200 font-bold font-mono min-w-[85px] text-right whitespace-nowrap">{ownerVal.toFixed(1)} / 4.0</span>
            </div>
          </div>

          <!-- Dimension 2: Type -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-zinc-800/80 pb-3 gap-3">
            <div class="flex flex-wrap items-center gap-2.5 min-w-0">
              <span class="text-zinc-500 font-bold shrink-0">[2]</span>
              <span class="text-zinc-100 font-bold shrink-0">政治與機構屬性</span>
              <span class="text-zinc-300 text-xs border border-zinc-800 bg-[#0e0e11] px-2 py-0.5 font-mono">
                [{translateType(item.type)}]
              </span>
            </div>
            <div class="flex items-center gap-3 shrink-0 ml-auto font-mono whitespace-nowrap">
              <div class="flex items-center gap-1 font-mono shrink-0">
                <span class="text-zinc-500 font-bold">[</span>
                <div class="flex items-center gap-[3px] w-28">
                  {Array.from({ length: 10 }).map((_, i) => (
                    <div
                      class={`h-2.5 flex-1 ${
                        i < barType.filledCount
                          ? barType.isMax
                            ? "bg-rose-500"
                            : "bg-zinc-100"
                          : "bg-[#27272e]"
                      }`}
                    />
                  ))}
                </div>
                <span class="text-zinc-500 font-bold">]</span>
              </div>
              <span class="text-zinc-200 font-bold font-mono min-w-[85px] text-right whitespace-nowrap">{typeVal.toFixed(1)} / 3.0</span>
            </div>
          </div>

          <!-- Dimension 3: Events -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-zinc-800/80 pb-3 gap-3">
            <div class="flex flex-wrap items-center gap-2.5 min-w-0">
              <span class="text-zinc-500 font-bold shrink-0">[3]</span>
              <span class="text-zinc-100 font-bold shrink-0">侵略歷史事件</span>
              <span class="text-zinc-300 text-xs border border-zinc-800 bg-[#0e0e11] px-2 py-0.5 font-mono">
                [{item.information.length} 筆歷史紀錄]
              </span>
            </div>
            <div class="flex items-center gap-3 shrink-0 ml-auto font-mono whitespace-nowrap">
              <div class="flex items-center gap-1 font-mono shrink-0">
                <span class="text-zinc-500 font-bold">[</span>
                <div class="flex items-center gap-[3px] w-28">
                  {Array.from({ length: 10 }).map((_, i) => (
                    <div
                      class={`h-2.5 flex-1 ${
                        i < barEvents.filledCount
                          ? barEvents.isMax
                            ? "bg-rose-500"
                            : "bg-zinc-100"
                          : "bg-[#27272e]"
                      }`}
                    />
                  ))}
                </div>
                <span class="text-zinc-500 font-bold">]</span>
              </div>
              <span class="text-zinc-200 font-bold font-mono min-w-[85px] text-right whitespace-nowrap">{eventsVal.toFixed(1)} / 3.0</span>
            </div>
          </div>

          <!-- Dimension 4: Group Inheritance -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div class="flex flex-wrap items-center gap-2.5 min-w-0">
              <span class="text-zinc-500 font-bold shrink-0">[4]</span>
              <span class="text-zinc-100 font-bold shrink-0">母公司與集團繼承</span>
              <span class="text-zinc-300 text-xs border border-zinc-800 bg-[#0e0e11] px-2 py-0.5 font-mono">
                [{parentName ? `繼承自母公司：${parentName}` : '獨立實體'}]
              </span>
            </div>

            <div class="flex items-center gap-3 shrink-0 ml-auto font-mono whitespace-nowrap">
              <div class="flex items-center gap-1 font-mono shrink-0">
                <span class="text-zinc-500 font-bold">[</span>
                <div class="flex items-center gap-[3px] w-28">
                  {Array.from({ length: 10 }).map((_, i) => (
                    <div
                      class={`h-2.5 flex-1 ${
                        i < barInheritance.filledCount
                          ? barInheritance.isMax
                            ? "bg-rose-500"
                            : "bg-zinc-100"
                          : "bg-[#27272e]"
                      }`}
                    />
                  ))}
                </div>
                <span class="text-zinc-500 font-bold">]</span>
              </div>
              <span class="text-zinc-200 font-bold font-mono min-w-[85px] text-right whitespace-nowrap">{inheritanceVal.toFixed(1)} / 10.0</span>
            </div>
          </div>
        </div>
      </section>



      <!-- Description -->
      {item.description && (
        <section class="border border-zinc-800 bg-[#16161a] p-6">
          <h2 class="mb-4 text-sm sm:text-base font-bold text-zinc-100 uppercase tracking-wider font-mono">
            + 條目詳細說明：
          </h2>
          <div class="text-sm sm:text-base text-zinc-200 leading-relaxed font-mono" set:html={renderMarkdown(item.description)} />
        </section>
      )}

      <!-- Information (invasion records) -->
      {item.information.length > 0 && (
        <section>
          <h2 class="mb-4 text-sm sm:text-base font-bold text-zinc-100 uppercase tracking-wider font-mono">
            + 侵略歷史事件紀錄 ({item.information.length})：
          </h2>
          <div class="space-y-4">
            {item.information
              .sort((a, b) => Number(b.year || 0) - Number(a.year || 0))
              .map((info) => (
                <div class="border border-zinc-800 bg-[#16161a] p-5 transition-colors hover:border-zinc-600 font-mono">
                  <div class="mb-3 flex items-center justify-between">
                    {info.year ? (
                      <span class="border border-zinc-800 bg-[#0e0e11] px-2.5 py-0.5 text-xs text-zinc-400 font-mono">
                        [{info.year}]
                      </span>
                    ) : (
                      <span class="text-xs text-zinc-500 font-mono">[歷史事件]</span>
                    )}
                    <ScoreBadge score={info.score} size="sm" />
                  </div>
                  <div class="text-sm sm:text-base text-zinc-200 leading-relaxed font-mono" set:html={renderMarkdown(info.description)} />
                </div>
              ))}
          </div>
        </section>
      )}


      <!-- Name Others -->
      {item.nameOthers.length > 0 && (
        <section class="border border-zinc-800 bg-[#16161a] p-4 font-mono">
          <h2 class="mb-2.5 text-xs font-bold uppercase text-zinc-300">+ 其他別名：</h2>
          <div class="flex flex-wrap gap-2">
            {item.nameOthers.map((no) => (
              <span class="border border-zinc-800 bg-[#0e0e11] px-2.5 py-1 text-xs text-zinc-300 font-mono">
                {no.name}
              </span>
            ))}
          </div>
        </section>
      )}

      <!-- Website -->
      {item.website && (
        <section class="border border-zinc-800 bg-[#16161a] p-4 font-mono">
          <h2 class="mb-2 text-xs font-bold uppercase text-zinc-300">+ 官方網站：</h2>
          <a
            href={item.website}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-xs text-zinc-300 hover:text-white underline transition-colors font-mono"
          >
            <span>{item.website}</span>
          </a>
        </section>
      )}
    </div>

    <!-- Related Items -->
    {relatedItems.length > 0 && (
      <section class="mt-12 border-t border-zinc-800 pt-8 font-mono">
        <h2 class="mb-4 text-xs font-bold text-zinc-200 uppercase font-mono">+ 相關關聯條目：</h2>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {relatedItems.map((ri) => (
            <a
              href={`/items/${ri.code}`}
              class="group flex items-center gap-3 border border-zinc-800 bg-[#16161a] p-3 transition-colors hover:border-zinc-600 font-mono"
            >
              <img
                src={`/logos/${ri.code}.jpg`}
                alt={ri.name}
                class="h-9 w-9 shrink-0 border border-zinc-800 bg-[#0e0e11] object-cover"
                loading="lazy"
                onerror="this.style.display='none'"
              />
              <div class="min-w-0 flex-1">
                <p class="truncate text-xs font-bold text-zinc-200 group-hover:text-white transition-colors font-mono">{ri.name}</p>
                <p class="text-[10px] text-zinc-500 font-mono">[{translateOwner(ri.owner)}]</p>
              </div>
              <ScoreBadge score={ri.score} size="sm" />
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>





